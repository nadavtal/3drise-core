    "gsap": "^3.12.0",
    "lodash": "^4.17.21",
    "maath": "^0.10.8"
  },
  "peerDependencies": {
    "three": "^0.170"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "three": "^0.170.0",
    "typescript": "^5.9.3"
  }
}

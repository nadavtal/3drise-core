{
  "name": "@3driseai/3drise-core",
  "version": "1.0.1",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build --force && node add-js-extensions.mjs",
    "dev": "tsc --build --watch",
